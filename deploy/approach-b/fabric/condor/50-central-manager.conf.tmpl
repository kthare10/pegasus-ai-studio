# PegasusAI Studio Approach-B — HTCondor central manager (config.d drop-in).
# Installed by provision-cm.sh as /etc/condor/config.d/50-central-manager.conf
# with @CONDOR_HOST@ replaced by the CM's pool-network IP.
#
# This loads AFTER the DEB's 00-security (`use security:recommended`), so our
# pool-identity knobs win while the template's IDTOKENS/SSL security stays intact.
# We deliberately do NOT re-set SEC_DEFAULT_* here (that caused "Unable to
# reconcile" in earlier container tests). Because HTCondor is installed via
# systemd, condor_master runs as root and reads the root-owned signing key — so
# the read_secure_file() failure seen with a bare `condor_master -f` does not occur.

CONDOR_HOST = @CONDOR_HOST@
COLLECTOR_HOST = $(CONDOR_HOST):9618

# Pool-wide trust domain — MUST be identical on the CM, execute nodes, and submit
# pods so IDTOKEN issuers match.
TRUST_DOMAIN = pegasus-studio-pool

# Central-manager daemons only; this is also the CCB broker endpoint.
DAEMON_LIST = MASTER, COLLECTOR, NEGOTIATOR, SHARED_PORT
USE_SHARED_PORT = TRUE
SHARED_PORT_PORT = 9618
CCB_ADDRESS = $(COLLECTOR_HOST)
UPDATE_COLLECTOR_WITH_TCP = TRUE

# Pool signing key used to mint IDTOKENs (created by provision-cm.sh).
SEC_TOKEN_POOL_SIGNING_KEY_FILE = /etc/condor/passwords.d/POOL

# Authenticated daemons may advertise/read/write. Tighten per-identity later.
ALLOW_ADVERTISE_MASTER = *
ALLOW_ADVERTISE_STARTD = *
ALLOW_ADVERTISE_SCHEDD = *
ALLOW_READ = *
ALLOW_WRITE = *
ALLOW_NEGOTIATOR = *

UPDATE_INTERVAL = 60
NEGOTIATOR_INTERVAL = 20
