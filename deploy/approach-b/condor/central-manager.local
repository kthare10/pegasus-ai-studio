# Shared HTCondor central manager for PegasusAI Studio — Approach B (M1).
#
# Runs the pool's collector + negotiator and acts as the CCB broker so that
# submit-only schedds living in unroutable pods can be reached by execute
# nodes. Daemons authenticate with IDTOKENS signed by this host's pool key.
#
# Reachable by the docker/k8s service name "cm" on the shared network.

CONDOR_HOST = cm
COLLECTOR_HOST = $(CONDOR_HOST):9618

# A single pool-wide trust domain. IDTOKENs are minted with this as the issuer,
# and every node selects tokens whose issuer matches its TRUST_DOMAIN — so it
# MUST be identical on the CM, execute nodes, and submit pods. (Default is the
# hostname, which differs per node and makes token selection fail.)
TRUST_DOMAIN = pegasus-studio-pool

DAEMON_LIST = MASTER, COLLECTOR, NEGOTIATOR, SHARED_PORT

# Single TCP port for the whole pool; this is also the CCB broker endpoint.
USE_SHARED_PORT = TRUE
SHARED_PORT_PORT = 9618

# Security: rely on the DEB default `use security:recommended` (config.d/00-security),
# which requires authentication (TOKEN/SSL) for WRITE/ADVERTISE and allows
# unauthenticated READ. We only add the pool signing key used to mint IDTOKENs
# (created by up.sh on this host). Do NOT re-set SEC_DEFAULT_* here — overriding
# the template partially causes "DC_AUTHENTICATE: Unable to reconcile".
SEC_TOKEN_POOL_SIGNING_KEY_FILE = /etc/condor/passwords.d/POOL

# Prototype auth: add PASSWORD (a shared pool secret distributed to every node)
# to the template's method list. This proves the shared pool + CCB end-to-end
# without the per-pod IDTOKENS issuer-bootstrap. We APPEND rather than replace,
# so the template's local/family sessions keep working. Per-pod IDTOKENS (for
# per-user pool identity) is layered back in after the networking risk is retired.
SEC_DEFAULT_AUTHENTICATION_METHODS = FS, PASSWORD, IDTOKENS, KERBEROS, SCITOKENS, SSL

# Authenticated daemons may advertise/read/write. Tighten per-identity later.
ALLOW_ADVERTISE_MASTER = *
ALLOW_ADVERTISE_STARTD = *
ALLOW_ADVERTISE_SCHEDD = *
ALLOW_READ = *
ALLOW_WRITE = *
ALLOW_NEGOTIATOR = *

# Shared-port pools should advertise over TCP (UDP updates don't carry the
# security session reliably behind shared_port).
UPDATE_COLLECTOR_WITH_TCP = TRUE

UPDATE_INTERVAL = 60
NEGOTIATOR_INTERVAL = 20
